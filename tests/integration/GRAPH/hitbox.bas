10 REM SET SPRITE HITBOX integration test

20 SCREEN 2,0
21 M$ = "8x8:" : GOSUB 100

30 SCREEN 2,1
31 M$ = "8x8 DOUBLE SIZE:" : GOSUB 100

40 SCREEN 2,2
41 M$ = "16x16:" : GOSUB 100

50 SCREEN 2,3
51 M$ = "16x16 DOUBLE SIZE:" : GOSUB 100

60 END 

100 GOSUB 400
101 GOSUB 500

110 SET SPRITE HITBOX 0,2,0,2,0
111 SET SPRITE HITBOX 1,2,0,2,0
112 M$ = "SHRINK BOTH:" : GOSUB 500

120 SET SPRITE HITBOX OFF
121 M$ = "OFF:" : GOSUB 500

130 SET SPRITE HITBOX ON
131 M$ = "ON:" : GOSUB 500

140 SET SPRITE HITBOX 0 OFF
141 M$ = "ONE OFF:" : GOSUB 500

150 SET SPRITE HITBOX 0 ON
151 M$ = "ONE ON:" : GOSUB 500

160 SET SPRITE HITBOX AUTO
161 M$ = "AUTO:" : GOSUB 500

170 SET SPRITE HITBOX 0
171 M$ = "RESET ONE:" : GOSUB 500

180 SET SPRITE HITBOX 1,3,2,3,2
181 M$ = "MARGIN OTHER:" : GOSUB 500

190 SET SPRITE HITBOX 0 AUTO
191 M$ = "ONE AUTO:" : GOSUB 500

200 RETURN

400 A$ = "AA6UU6AA~~BBBB~~AA6UU6AA~~BBBB~~" : A$ = A$ + A$ + A$ + A$
401 SPRITE$(0) = A$
402 SPRITE$(1) = A$
403 RETURN 

500 X% = 0 : Y% = 100
501 CLS : LOCATE 0, 0 : PRINT M$
510 PUT SPRITE 0,(X%,Y%),15,0
511 PUT SPRITE 1,(250 - X%,Y%),15,1
520 IF COLLISION(0,1) >= 0 OR X% > 200 THEN 530
521   X% = X% + 1
522   GOTO 510
530 'B$ = INPUT$(1)
531 RETURN 
