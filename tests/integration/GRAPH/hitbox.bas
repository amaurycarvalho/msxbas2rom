' SET SPRITE HITBOX integration test

10 A$ = "AA6UU6AA~~BBBB~~AA6UU6AA~~BBBB~~" 

20 SCREEN 2,0
21 M$ = "8x8:" : GOSUB 100

30 SCREEN 2,1
31 M$ = "8x8 DOUBLE SIZE:" : GOSUB 100

40 A$ = "0000"+CHR$(15)+CHR$(15)+"33"+"33"+CHR$(15)+CHR$(15)+"0000"+CHR$(3)+CHR$(3)+CHR$(3)+CHR$(3)+"<<33"+"33<<"+CHR$(3)+CHR$(3)+CHR$(3)+CHR$(3) 

50 SCREEN 2,2
51 M$ = "16x16:" : GOSUB 100

60 SCREEN 2,3
61 M$ = "16x16 DOUBLE SIZE:" : GOSUB 100

70 END 

100 GOSUB 400
101 GOSUB 500

110 SET SPRITE HITBOX 0,2,2,2,2
111 SET SPRITE HITBOX 1,2,2,2,2
112 M$ = "SHRINK BOTH:" : GOSUB 500

120 SET SPRITE HITBOX OFF
121 M$ = "OFF:" : GOSUB 500

130 SET SPRITE HITBOX ON
131 M$ = "ON:" : GOSUB 500

140 SET SPRITE HITBOX 0 OFF
141 M$ = "ONE OFF:" : GOSUB 500

150 SET SPRITE HITBOX 0 ON
151 M$ = "ONE ON:" : GOSUB 500

160 SET SPRITE HITBOX AUTO
161 M$ = "AUTO:" : GOSUB 500

170 SET SPRITE HITBOX 0
171 M$ = "RESET ONE:" : GOSUB 500

180 SET SPRITE HITBOX 1,3,2,3,2
181 M$ = "MARGIN OTHER:" : GOSUB 500

190 SET SPRITE HITBOX 0 AUTO
191 M$ = "ONE AUTO:" : GOSUB 500

200 RETURN

400 REM
401 SPRITE$(0) = A$
402 SPRITE$(1) = A$
403 RETURN 

' horizontal collision
500 X% = 0 : Y% = 100
501 CLS : LOCATE 0, 0 : PRINT M$
510 PUT SPRITE 0,(X%, Y%),15,0
511 PUT SPRITE 1,(250 - X%,Y%),15,1
520 IF COLLISION(0,1) >= 0 OR X% > 200 THEN 530
521   X% = X% + 1
522   GOTO 510
530 B$ = INPUT$(1)

' side-impact collision (\)
600 X% = 50 : Y% = 50
610 PUT SPRITE 0,(X%, Y%),15,0
611 PUT SPRITE 1,(150 - X%, 150 - Y%),15,1
620 IF COLLISION(0,1) >= 0 OR Y% > 100 THEN 630
621   X% = X% + 1 : Y% = Y% + 1
622   GOTO 610
630 B$ = INPUT$(1)

' vertical collision
700 X% = 100 : Y% = 50
710 PUT SPRITE 0,(X%, Y%),15,0
711 PUT SPRITE 1,(X%, 150 - Y%),15,1
720 IF COLLISION(0,1) >= 0 OR Y% > 100 THEN 730
721   Y% = Y% + 1
722   GOTO 710
730 B$ = INPUT$(1)

' side-impact collision (/)
800 X% = 100 : Y% = 50
810 PUT SPRITE 0,(X%, Y%),15,0
811 PUT SPRITE 1,(150 - X%, 150 - Y%),15,1
820 IF COLLISION(0,1) >= 0 OR Y% > 100 THEN 830
821   X% = X% - 1 : Y% = Y% + 1
822   GOTO 810
830 B$ = INPUT$(1)

900 RETURN 
