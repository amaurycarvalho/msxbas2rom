10 REM TILE_BANK_ALL.BAS - BANK >2 MEANS ALL BANKS
15 BK%=2
20 SCREEN 2
30 REM PATTERN, BANK 3 / 9 / 200
40 SET TILE PATTERN 90, (1,2,3,4,5,6,7,8), 3
50 SET TILE PATTERN 91, (11,12,13,14,15,16,17,18), 9
60 SET TILE PATTERN 92, (21,22,23,24,25,26,27,28), 200
70 REM COLOR, BANK 3 / 9 / 200
80 SET TILE COLOR 90, 1, 15, 3
90 SET TILE COLOR 91, 2, 14, 9
100 SET TILE COLOR 92, 3, 13, 200
110 REM FLIP WITH BANK 9, BANKS 1/2 START ZERO
120 SET TILE PATTERN 93, (0,0,0,0,0,0,0,0), 3
130 SET TILE PATTERN 93, (1,2,4,8,16,32,64,128), 0
140 SET TILE FLIP 93, 0, 9
150 REM ROTATE WITH BANK 200, BANKS 1/2 START ZERO
160 SET TILE PATTERN 94, (0,0,0,0,0,0,0,0), 3
170 SET TILE PATTERN 94, (128,0,0,0,0,0,0,0), 0
180 SET TILE ROTATE 94, 0, 200
190 REM GET WITH BANK >2 MUST READ BANK 0
200 SET TILE PATTERN 80, (1,1,1,1,1,1,1,1), 0
210 SET TILE PATTERN 80, (2,2,2,2,2,2,2,2), 1
220 SET TILE PATTERN 80, (3,3,3,3,3,3,3,3), 2
230 DIM Q%(3)
240 GET TILE PATTERN 80, Q%(), 3
250 SET TILE PATTERN 95, Q%(), 9
260 GET TILE PATTERN 80, Q%(), 200
270 SET TILE PATTERN 96, Q%(), 200
280 DIM C%(3)
290 GET TILE COLOR 90, C%(), 3
300 SET TILE COLOR 97, C%(), 9
310 GET TILE COLOR 90, C%(), 200
320 SET TILE COLOR 98, C%(), 200
325 SET TILE COLOR 99, (1,2,3,4,5,6,7,8), (15,14,13,12,11,10,9,8), 9
327 SET TILE COLOR 100, 1, 16, 0
335 SET TILE COLOR 101, (1,2,3,4), BK%
340 GOTO 340
