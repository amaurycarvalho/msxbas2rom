' CMD RSCTORAM offset/size regression

FILE "string.bin"
FILE "string.txt.plet5"

5 CLS
10 A$ = SPACE$(100)
20 CMD RSCTORAM 0, VARPTR(A$)+1, 0, 2, 3
30 PRINT "EXACT=";PEEK(VARPTR(A$)+1);",";PEEK(VARPTR(A$)+2);",";PEEK(VARPTR(A$)+3)
40 CMD RSCTORAM 0, VARPTR(A$)+1, 0, 10, 100
50 PRINT "CLAMP=";PEEK(VARPTR(A$)+1);",";PEEK(VARPTR(A$)+2);",";PEEK(VARPTR(A$)+3)
60 CMD RSCTORAM 0, VARPTR(A$)+1, 0, 2, 0
70 PRINT "FULL=";PEEK(VARPTR(A$)+1);",";PEEK(VARPTR(A$)+11)
80 POKE VARPTR(A$)+1, &HAA
90 CMD RSCTORAM 0, VARPTR(A$)+1, 0, 13, 1
100 PRINT "END=";PEEK(VARPTR(A$)+1)
110 POKE VARPTR(A$)+1, &HAA
120 CMD RSCTORAM 9, VARPTR(A$)+1, 0, 0, 1
130 PRINT "MISS=";PEEK(VARPTR(A$)+1)
140 CMD RSCTORAM 1, VARPTR(A$)+1, 1, 5, 2
150 PRINT "PLET=";LEFT$(A$,5)
160 END
