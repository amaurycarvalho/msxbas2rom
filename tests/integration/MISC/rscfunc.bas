' RESOURCE() load-to-RAM regression

FILE "string.bin"

5 CLS
10 A=RESOURCE(0)
20 B=RESOURCE(0)
30 PRINT "SAME=";A-B
40 PRINT "B0=";PEEK(A)
50 PRINT "B1=";PEEK(A+1)
60 PRINT "B2=";PEEK(A+2)
70 PRINT "INV=";RESOURCE(9)
80 PRINT "SIZE=";RESOURCESIZE(0)
90 A=RESOURCE(0)
100 POKE A,&HAB
110 X=RESOURCE(9)
120 PRINT "KEEP=";PEEK(A)
130 END
