' TURBO R R800 DRAM MODE CLAMP REGRESSION

10 IF MSX()<>3 THEN PRINT "TURBO2 NO TURBO R":END
20 CAN% = &H5AA5
30 CMD TURBO 0
40 PRINT "TURBO2 START=";TURBO()
50 CMD TURBO 2
60 IF TURBO()=2 THEN PRINT "TURBO2 AFTER=BAD" ELSE PRINT "TURBO2 AFTER=OK"
70 IF CAN%<>&H5AA5 THEN PRINT "TURBO2 CANARY=BAD" ELSE PRINT "TURBO2 CANARY=OK"
80 CMD TURBO 0
90 PRINT "TURBO2 DONE"
100 END
