' TURBO TEST FOR MSX2+ AND TURBOR MACHINES

10 IF MSX()<2 THEN PRINT "TURBO TEST CANNOT RUN IN THIS MACHINE":END

20 CMD TURBO 0
21 PRINT "PROCESSING TIME (TURBO OFF) = ";
22 GOSUB 100
23 PRINT D%

30 CMD TURBO 1
31 PRINT "PROCESSING TIME (TURBO ON) = ";
32 GOSUB 100
33 PRINT D%

40 CMD TURBO 0
41 PRINT "TURBO TEST OK"
42 END

100 T% = TIME 
101 S% = 0
102 FOR I% = 0 TO 1000
103   S% = S% + I%
104 NEXT
105 D% = TIME - T%
106 RETURN
